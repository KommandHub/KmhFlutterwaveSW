{
    "name": "kommandhub/flutterwave-sw",
    "description": "Professional Shopware 6 integration for Flutterwave: accept secure payments via cards, bank transfers, and mobile money. Expand your reach across Africa with this reliable checkout solution.",
    "type": "shopware-platform-plugin",
    "version": "0.9.0-beta.1",
    "license": "Apache-2.0",
    "keywords": [
        "shopware",
        "shopware6",
        "shopware-plugin",
        "shopware-payment",
        "flutterwave",
        "payment",
        "payment-gateway",
        "checkout",
        "refund",
        "webhook",
        "mobile-money",
        "bank-transfer",
        "africa",
        "nigeria",
        "ecommerce"
    ],
    "homepage": "https://github.com/KommandHub/KommandhubFlutterwaveSW",
    "authors": [
        {
            "name": "Kommandhub Limited",
            "email": "info@kommandhub.com",
            "homepage": "https://kommandhub.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@kommandhub.com",
        "issues": "https://github.com/KommandHub/KommandhubFlutterwaveSW/issues",
        "source": "https://github.com/KommandHub/KommandhubFlutterwaveSW",
        "docs": "https://github.com/KommandHub/KommandhubFlutterwaveSW/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.6.0 || ~6.7.0",
        "shopware/storefront": "~6.6.0 || ~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "shopware/dev-tools": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Kommandhub\\FlutterwaveSW\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kommandhub\\FlutterwaveSW\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Kommandhub\\FlutterwaveSW\\KommandhubFlutterwaveSW",
        "label": {
            "de-DE": "Flutterwave-Zahlung von Kommandhub",
            "en-GB": "Flutterwave Payment by Kommandhub",
            "fr-FR": "Paiement Flutterwave par Kommandhub"
        },
        "description": {
            "de-DE": "Professionelle, unabhängige Shopware-6-Integration für das Flutterwave-Zahlungsgateway: sichere Zahlungen per Karte, Banküberweisung und Mobile Money in Afrika, inkl. Erstattungen.",
            "en-GB": "Professional, independent Shopware 6 integration for the Flutterwave payment gateway: secure card, bank transfer, and mobile money payments across Africa, with refunds and webhooks.",
            "fr-FR": "Intégration Shopware 6 indépendante et professionnelle pour la passerelle Flutterwave : paiements sécurisés par carte, virement et mobile money en Afrique, avec remboursements."
        },
        "manufacturerLink": {
            "de-DE": "https://kommandhub.com",
            "en-GB": "https://kommandhub.com"
        },
        "supportLink": {
            "de-DE": "https://kommandhub.com/support",
            "en-GB": "https://kommandhub.com/support"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
