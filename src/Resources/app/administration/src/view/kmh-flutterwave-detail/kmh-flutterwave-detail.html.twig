{% block sw_order_document_card %}
    {% block kmh_flutterwave_detail_card %}
    <mt-card
            v-if="order"
            position-identifier="sw-order-document-card"
            class="kmh-flutterwave-detail-card"
    >
        {% block kmh_flutterwave_detail_card_banner %}
            <div
                    v-if="flutterwaveIcon"
                    class="kmh-flutterwave-detail-card__banner"
            >
                {% block kmh_flutterwave_detail_card_banner_icon %}
                <img
                        :src="flutterwaveIcon"
                        class="kmh-flutterwave-detail-card__icon"
                        alt="Flutterwave logo"
                >
                {% endblock %}

                {% block kmh_flutterwave_detail_card_banner_title %}
                <h3 class="kmh-flutterwave-detail-card__header">
                    {{ $t('kmh-flutterwave-detail.header') }}
                </h3>
                {% endblock %}
            </div>
        {% endblock %}

        {% block kmh_flutterwave_detail_card_grid %}
            <template #grid>
                {% block kmh_flutterwave_detail_content %}
                {% block kmh_flutterwave_detail_transaction_grid %}
                <sw-data-grid
                        v-if="flutterwaveTransaction"
                        :data-source="flutterwaveTransactionData"
                        :columns="flutterwaveTransactionColumns"
                        :show-selection="false"
                        :show-actions="true"
                        class="kmh-flutterwave-detail-grid"
                >
                    <template #column-amount="{ item }">
                        {% block kmh_flutterwave_detail_grid_column_amount %}
                        {{ currencyFilter(item.amount, item.currency) }}
                        {% endblock %}
                    </template>

                    <template #column-settled="{ item }">
                        {% block kmh_flutterwave_detail_grid_column_settled %}
                        <template v-if="item.settled">{{ currencyFilter(item.settled, item.currency) }}</template>
                        <template v-else>–</template>
                        {% endblock %}
                    </template>

                    <template #column-fee="{ item }">
                        {% block kmh_flutterwave_detail_grid_column_fee %}
                        {{ currencyFilter(item.fee, item.currency) }}
                        {% endblock %}
                    </template>

                    <template #column-channel="{ item }">
                        {% block kmh_flutterwave_detail_grid_column_channel %}
                        <sw-label v-if="item.channel" variant="info" appearance="pill" size="small">
                            {{ item.channel }}
                        </sw-label>
                        <template v-else>–</template>
                        {% endblock %}
                    </template>

                    <template #column-paymentMethod="{ item }">
                        {% block kmh_flutterwave_detail_grid_column_payment_method %}
                        <template v-if="item.paymentMethod && item.paymentMethod.translated">
                            {{ item.paymentMethod.translated.name }}
                        </template>
                        <template v-else>–</template>
                        {% endblock %}
                    </template>

                    <template #column-state="{ item }">
                        {% block kmh_flutterwave_detail_grid_column_state %}
                        <sw-label
                                v-if="item.state && item.state.translated"
                                variant="neutral"
                                appearance="pill"
                        >
                            {{ item.state.translated.name }}
                        </sw-label>
                        {% endblock %}
                    </template>

                    <template #column-verifiedAt="{ item }">
                        {% block kmh_flutterwave_detail_grid_column_verified_at %}
                        <sw-time-ago
                                v-if="item.verifiedAt"
                                :date="item.verifiedAt"
                                :date-time-format="{ month: '2-digit', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }"
                        />
                        <template v-else>–</template>
                        {% endblock %}
                    </template>

                    <template #actions="{ item }">
                        {% block kmh_flutterwave_detail_grid_actions_refund %}
                        <sw-context-menu-item
                                v-if="canRefund"
                                @click="onOpenRefundModal(item)"
                        >
                            {{ $t('kmh-flutterwave-detail.grid.refund') }}
                        </sw-context-menu-item>
                        {% endblock %}
                    </template>
                </sw-data-grid>
                {% endblock %}

                {% block kmh_flutterwave_detail_empty_state %}
                <mt-empty-state
                        v-else
                        :headline="$t('kmh-flutterwave-detail.emptyState.title')"
                        :description="$t('kmh-flutterwave-detail.emptyState.subline')"
                        icon="regular-credit-card"
                        centered
                        class="kmh-flutterwave-detail-empty-state"
                />
                {% endblock %}
                {% endblock %}
            </template>
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block kmh_flutterwave_detail_captures_card %}
    <mt-card
            v-if="order && flutterwaveTransaction && captures.length"
            position-identifier="kmh-flutterwave-detail-captures-card"
            class="kmh-flutterwave-detail-captures-card"
    >
        <template #default>
            {% block kmh_flutterwave_detail_captures_title %}
            <h3 class="kmh-flutterwave-detail-captures-card__title">
                {{ $t('kmh-flutterwave-detail.captures.title') }}
            </h3>
            {% endblock %}

            {% block kmh_flutterwave_detail_captures_grid %}
            <sw-data-grid
                    :data-source="captures"
                    :columns="flutterwaveCaptureColumns"
                    :show-selection="false"
                    :show-actions="true"
                    class="kmh-flutterwave-detail-captures-grid"
            >
                <template #column-amount="{ item }">
                    {% block kmh_flutterwave_detail_captures_grid_column_amount %}
                    {{ currencyFilter(item.amount ? item.amount.totalPrice : 0, customFields.flutterwave_currency) }}
                    {% endblock %}
                </template>

                <template #column-state="{ item }">
                    {% block kmh_flutterwave_detail_captures_grid_column_state %}
                    <sw-label v-if="item.state" variant="neutral" appearance="pill">
                        {{ item.state }}
                    </sw-label>
                    <template v-else>–</template>
                    {% endblock %}
                </template>

                <template #column-createdAt="{ item }">
                    {% block kmh_flutterwave_detail_captures_grid_column_created_at %}
                    <sw-time-ago
                            v-if="item.createdAt"
                            :date="item.createdAt"
                            :date-time-format="{ month: '2-digit', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }"
                    />
                    <template v-else>–</template>
                    {% endblock %}
                </template>

                <template #actions="{ item }">
                    {% block kmh_flutterwave_detail_captures_grid_actions %}
                    <sw-context-menu-item
                            v-if="item.refunds && item.refunds.length"
                            @click="onOpenRefundsListModal(item)"
                    >
                        {{ $t('kmh-flutterwave-detail.captures.grid.refunds') }}
                    </sw-context-menu-item>
                    {% endblock %}
                </template>
            </sw-data-grid>
            {% endblock %}
        </template>
    </mt-card>
    {% endblock %}

    {% block kmh_flutterwave_detail_refunds_list_modal %}
    <sw-modal
            v-if="order && showRefundsListModal"
            :title="$t('kmh-flutterwave-detail.refunds.listModalTitle')"
            @modal-close="onCloseRefundsListModal"
    >
        {% block kmh_flutterwave_detail_refunds_list_grid %}
        <sw-data-grid
                :data-source="flutterwaveRefunds"
                :columns="flutterwaveRefundColumns"
                :show-selection="false"
                :show-actions="false"
                class="kmh-flutterwave-detail-refunds-grid"
        >
            <template #column-amount="{ item }">
                {% block kmh_flutterwave_detail_refunds_list_grid_column_amount %}
                {{ currencyFilter(item.amount ? item.amount.totalPrice : 0, customFields.flutterwave_currency) }}
                {% endblock %}
            </template>

            <template #column-state="{ item }">
                {% block kmh_flutterwave_detail_refunds_list_grid_column_state %}
                <sw-label v-if="item.state" variant="neutral" appearance="pill">
                    {{ item.state }}
                </sw-label>
                <template v-else>–</template>
                {% endblock %}
            </template>

            <template #column-externalReference="{ item }">
                {% block kmh_flutterwave_detail_refunds_list_grid_column_external_reference %}
                <template v-if="item.externalReference">{{ item.externalReference }}</template>
                <template v-else>–</template>
                {% endblock %}
            </template>

            <template #column-createdAt="{ item }">
                {% block kmh_flutterwave_detail_refunds_list_grid_column_created_at %}
                <sw-time-ago
                        v-if="item.createdAt"
                        :date="item.createdAt"
                        :date-time-format="{ month: '2-digit', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }"
                />
                <template v-else>–</template>
                {% endblock %}
            </template>
        </sw-data-grid>
        {% endblock %}

        {% block kmh_flutterwave_detail_refunds_list_modal_footer %}
        <template #modal-footer>
            <mt-button
                    variant="secondary"
                    size="small"
                    @click="onCloseRefundsListModal"
            >
                {{ $t('global.default.close') }}
            </mt-button>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}

    {% block kmh_flutterwave_detail_refund_modal %}
    <sw-modal
            v-if="order && showRefundModal"
            :title="$t('kmh-flutterwave-detail.refund.modalTitle')"
            @modal-close="onCloseRefundModal"
    >
        {% block kmh_flutterwave_detail_refund_modal_content %}
        <sw-container columns="1fr 1fr" gap="16px">
            {% block kmh_flutterwave_detail_refund_modal_amount_field %}
            <mt-number-field
                    v-model="refundAmount"
                    :label="$t('kmh-flutterwave-detail.refund.amountLabel')"
                    :placeholder="$t('kmh-flutterwave-detail.refund.amountPlaceholder')"
                    :help-text="$t('kmh-flutterwave-detail.refund.amountHelpText')"
                    number-type="float"
                    :digits="refundAmountDigits"
                    :min="minRefundableAmount"
                    :max="Number(maxRefundableAmount)"
            />
            {% endblock %}

            {% block kmh_flutterwave_detail_refund_modal_currency_field %}
            <mt-text-field
                    v-model="refundCurrency"
                    :label="$t('kmh-flutterwave-detail.refund.currencyLabel')"
                    disabled
            />
            {% endblock %}
        </sw-container>

        {% block kmh_flutterwave_detail_refund_modal_comments_field %}
        <mt-text-field
                v-model="comments"
                :label="$t('kmh-flutterwave-detail.refund.commentsLabel')"
                :placeholder="$t('kmh-flutterwave-detail.refund.commentsPlaceholder')"
        />
        {% endblock %}
        {% endblock %}

        {% block kmh_flutterwave_detail_refund_modal_footer %}
        <template #modal-footer>
            <mt-button
                    variant="secondary"
                    size="small"
                    @click="onCloseRefundModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>

            <sw-button-process
                    variant="primary"
                    size="small"
                    :isLoading="isRefundLoading"
                    :processSuccess="isRefundSuccess"
                    @process-finish="onRefundFinished"
                    @update:processSuccess="onRefundFinished"
                    @click="onConfirmRefund"
            >
                {{ $t('kmh-flutterwave-detail.refund.confirmButton') }}
            </sw-button-process>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}
{% endblock %}
